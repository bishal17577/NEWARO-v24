{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, role, and gift coin wallet state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "shop_owner", "admin", "freelancer"] },
        "giftCoins": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Verified local storefront managed by shop owner or admin.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 2048 },
        "coverUrl": { "type": "string", "maxLength": 2048 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "blocked"] },
        "approved": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["ownerId", "name", "category", "phone", "address", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product item listed under a storefront.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "maxLength": 128 },
        "shopName": { "type": "string", "maxLength": 150 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerEmail": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" }
      },
      "required": ["shopId", "sellerId", "name", "price", "stock", "category", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer Cash on Delivery order.",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 120 },
        "buyerEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "buyerPhone": { "type": "string", "maxLength": 40 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "shopId": { "type": "string", "maxLength": 128 },
        "shopName": { "type": "string", "maxLength": 150 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["buyerId", "buyerName", "buyerPhone", "shopId", "total", "status", "createdAt"]
    },
    "JobItem": {
      "title": "JobItem",
      "description": "Freelance gig and contracting opportunity.",
      "type": "object",
      "properties": {
        "posterId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "companyOrClient": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["full-time", "part-time", "freelance", "remote", "contract"] },
        "category": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "salaryOrBudget": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "number" }
      },
      "required": ["posterId", "title", "companyOrClient", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and gift coin balances."
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Local stores managed by shop owner or admin."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products managed by shop owner or admin."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/jobs/{jobId}": {
      "schema": "JobItem",
      "description": "Freelance gigs and jobs."
    }
  }
}
